SHOPIFY_SHOP=codex-mcp-2.myshopify.com
SHOPIFY_ADMIN_API_VERSION=2025-10
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_replace_me
MCP_SHARED_SECRET=replace_with_long_random_secret

# Optional for the Node MCP bridge. If MCP_MIDDLEWARE_BASE_URL and MCP_SHARED_SECRET
# are set, the bridge uses the PHP middleware. If they are omitted, the bridge
# can connect directly to Shopify with SHOPIFY_SHOP and SHOPIFY_ADMIN_ACCESS_TOKEN.
MCP_MIDDLEWARE_BASE_URL=https://thedigitalimpressions.com/downloads/mcp
MCP_HTTP_TIMEOUT_MS=15000
LOG_PATH=storage/logs/app.log
