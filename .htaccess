Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:src|config|storage|mcp-server|scripts)(?:/|$) - [F,L]
    RewriteRule ^(?:README\.md|\.env|\.gitignore|\.codex)(?:/|$) - [F,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ public/index.php [L]
</IfModule>
